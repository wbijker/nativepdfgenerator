<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfSpec.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PdfSpec/PdfSpec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled TrueType faces consumed by SampleCombined's font-metrics
         section. Embedded as resources so the sample binary stays
         self-contained; RootNamespace + folder yields the manifest names
         "PdfSpec.Samples.Fonts.<name>.ttf" that SampleFonts looks up. -->
    <EmbeddedResource Include="Fonts/Paintingwithchocolate-K5mo.ttf" />
    <EmbeddedResource Include="Fonts/Quake3d.ttf" />
  </ItemGroup>

</Project>
